# ==============================================================================
# AttendanceSystem Environment Configuration (Template)
# Copy this file to '.env' and update values for your environment.
# ==============================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
PORT=5000

# Database Configuration (Amazon RDS MySQL or Local MySQL)
# Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DB_ENGINE=mysql
DB_USER=admin
DB_PASSWORD=your_secure_rds_password
DB_HOST=attendance-db.c1234567890.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=attendance_system

# Optional: Direct SQLAlchemy connection string override
# For SQLite (local quick testing without MySQL installed):
# SQLALCHEMY_DATABASE_URI=sqlite:///attendance_system.db
# For MySQL:
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://admin:password@localhost:3306/attendance_system

# AWS S3 Configuration (For CSV Reports)
AWS_REGION=us-east-1
S3_BUCKET_NAME=attendancesystem-exports-bucket
# Note: On EC2, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty to use the IAM Role!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_EXPIRATION=3600

# Initial Admin Bootstrap (Used during initial seeding if run)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@attendance.edu
ADMIN_PASSWORD=Admin@SecurePass2026
ADMIN_FULL_NAME=System Administrator
